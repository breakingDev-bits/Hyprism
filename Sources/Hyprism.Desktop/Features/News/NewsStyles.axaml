<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Hyprism.Desktop.Controls"
        xmlns:easing="using:Avalonia.Animation.Easings"
        xmlns:instances="using:Hyprism.Desktop.Features.Instances"
        xmlns:news="using:Hyprism.Desktop.Features.News"
        xmlns:profiles="using:Hyprism.Desktop.Features.Profiles"
        xmlns:settings="using:Hyprism.Desktop.Features.Settings">
  <!-- Selectors owned by the News feature -->

  <Style Selector="Button.newsListItem">
    <Setter Property="Height" Value="104" />
    <Setter Property="Padding" Value="10,10,4,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.newsListItem:pointerover">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.newsListItem:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.newsListItem.selected">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="Button.newsLoadMore">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.newsLoadMore:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.newsLoadMore:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Border.newsThumbnail">
    <Setter Property="Background" Value="#1B1C20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.newsArticleHeader">
    <Setter Property="Background" Value="#17181B" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="StackPanel.articleBody">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="StackPanel.articleBody.revealed">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="StackPanel.articleBody.preparing">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>

  <Style Selector="StackPanel.articleBodySkeleton">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="StackPanel.articleBodySkeleton.fading">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.articleTextSkeleton">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#16FFFFFF" Offset="0" />
        <GradientStop Color="#32FFFFFF" Offset="0.5" />
        <GradientStop Color="#16FFFFFF" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.25" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.82" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.articleTextSkeleton.phase2">
    <Style.Animations>
      <Animation Duration="0:0:1.25" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.7" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.34" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.7" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.articleTextSkeleton.phase3">
    <Style.Animations>
      <Animation Duration="0:0:1.55" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
        <KeyFrame Cue="45%">
          <Setter Property="Opacity" Value="0.74" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.articleSkeletonCard">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="BorderBrush" Value="#18FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>

  <Style Selector="Border.articleToolbar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.articleToolbar.compact">
    <Setter Property="Margin" Value="24,18,40,12" />
    <Setter Property="MaxWidth" Value="820" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.articleToolbarTitle">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.articleToolbar.compact.scrolled TextBlock.articleToolbarTitle">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.articleBack">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.articleBack:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleBack:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleBack Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Keep the scrollbar layout stable and animate only the thumb rendering. -->
  <Style Selector="ScrollViewer[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.ColumnSpan" Value="1" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical">
    <Setter Property="Width" Value="12" />
    <Setter Property="Margin" Value="0,12,4,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarPanningThumbBackground}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="RenderTransform" Value="scaleX(0.5)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
          <TransformOperationsTransition.Easing>
            <easing:CubicEaseInOut />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical[IsExpanded=true] /template/ Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundColor}" />
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb /template/ Border">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.articleAction">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.articleAction:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleAction:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleAction Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="news|NewsRichTextBlock.articleParagraph">
    <Setter Property="Foreground" Value="#E1E2E5" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style Selector="news|NewsRichTextBlock.articleHeading">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="news|NewsRichTextBlock.articleCaption">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.articleQuote">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="CornerRadius" Value="3,12,12,3" />
  </Style>

  <Style Selector="Border.articleDetails">
    <Setter Property="Background" Value="#101A2230" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Button.articleDetailsHeader">
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                HorizontalAlignment="Stretch"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.articleDetailsHeader:pointerover">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleDetailsHeader:pressed">
    <Setter Property="Background" Value="#0CFFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="news|NewsRichTextBlock.articleDetailsSummary">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Border.articleDetailsBody">
    <Setter Property="BorderBrush" Value="#20FFFFFF" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10,16,0" />
  </Style>

  <Style Selector="Border.articleImage">
    <Setter Property="Background" Value="#16000000" />
    <Setter Property="BorderBrush" Value="#20FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MinHeight" Value="120" />
  </Style>

  <Style Selector="Border.articleVideo">
    <Setter Property="Background" Value="#16000000" />
    <Setter Property="BorderBrush" Value="#20FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.articleVideoLink">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.articleVideoLink:pointerover">
    <Setter Property="Background" Value="#10000000" />
  </Style>

  <Style Selector="Border.articleVideoLink:pressed">
    <Setter Property="Background" Value="#20000000" />
  </Style>

  <Style Selector="Button.articleVideoWatchButton StackPanel.articleVideoActionIdle, Button.articleVideoWatchButton StackPanel.articleVideoActionHover">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.articleVideoWatchButton StackPanel.articleVideoActionIdle">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>

  <Style Selector="Button.articleVideoWatchButton StackPanel.articleVideoActionHover">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 8px)" />
  </Style>

  <Style Selector="Button.articleVideoWatchButton:pointerover StackPanel.articleVideoActionIdle">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, -8px)" />
  </Style>

  <Style Selector="Button.articleVideoWatchButton:pointerover StackPanel.articleVideoActionHover">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>

  <Style Selector="Border.articleVideoWatch Path.articleVideoYoutubeIcon">
    <Setter Property="Fill" Value="White" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.articleVideoWatch TextBlock.articleVideoWatchText">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Border.articleVideoWatch Path.articleVideoExternalIcon">
    <Setter Property="Fill" Value="White" />
  </Style>

  <Style Selector="Button.articleVideoWatchButton:pointerover Path.articleVideoYoutubeIcon">
    <Setter Property="Fill" Value="#FF0033" />
  </Style>

  <Style Selector="Border.articleCode">
    <Setter Property="Background" Value="#E615151B" />
    <Setter Property="BorderBrush" Value="#456F63A3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,14" />
  </Style>


</Styles>

